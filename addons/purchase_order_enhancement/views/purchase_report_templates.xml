<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_enhanced" inherit_id="purchase.report_purchaseorder_document">
        <!-- Add Serial Number header as first column -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_serial" class="text-center" style="width: 5%;">Sr. No.</th>
        </xpath>
        
        <!-- Add Serial Number cell for product lines -->
        <xpath expr="//table[contains(@class, 'o_main_table')]//tbody//tr/t[@t-if='not line.display_type']/td[1]" position="before">
            <td name="td_serial" class="text-center">
                <span t-out="line_index + 1"/>
            </td>
        </xpath>
    </template>
</odoo>
