<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Create 18% GST Tax -->
        <record id="account_tax_gst_18" model="account.tax">
            <field name="name">GST 18%</field>
            <field name="description">GST 18%</field>
            <field name="amount">18.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="active">True</field>
            <field name="sequence">10</field>
        </record>
        
        <!-- Create 18% GST Tax for Purchases -->
        <record id="account_tax_gst_18_purchase" model="account.tax">
            <field name="name">GST 18% (Purchase)</field>
            <field name="description">GST 18%</field>
            <field name="amount">18.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="active">True</field>
            <field name="sequence">10</field>
        </record>
        
    </data>
</odoo>
