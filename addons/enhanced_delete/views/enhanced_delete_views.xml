<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="enhanced_delete_wizard_form" model="ir.ui.view">
        <field name="name">enhanced.delete.wizard.form</field>
        <field name="model">enhanced.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Confirmation">
                <div class="alert alert-warning" role="alert">
                    <strong>Warning!</strong> The following records have linked data that may be affected by this deletion.
                </div>
                <group>
                    <field name="linked_records_info" readonly="1" widget="text"/>
                </group>
                <group>
                    <field name="action" widget="radio"/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="enhanced_delete_wizard_action" model="ir.actions.act_window">
        <field name="name">Delete Confirmation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">enhanced.delete.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="enhanced_delete_wizard_form"/>
    </record>
</odoo>