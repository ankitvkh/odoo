<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Add Location field to Account Move Form -->
    <record id="view_move_form_location" model="ir.ui.view">
        <field name="name">account.move.form.location</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="location_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
    
    <!-- Add Location field to Account Move Tree -->
    <record id="view_invoice_tree_location" model="ir.ui.view">
        <field name="name">account.move.tree.location</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="location_id" optional="show"/>
            </xpath>
        </field>
    </record>
    
    <!-- Add Location filter to Account Move Search -->
    <record id="view_account_invoice_filter_location" model="ir.ui.view">
        <field name="name">account.move.search.location</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="location_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Location" name="group_location" 
                        context="{'group_by': 'location_id'}"/>
            </xpath>
        </field>
    </record>
    
</odoo>
