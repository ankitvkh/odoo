<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Record Rules: Filter Sales Orders by Location -->
        <record id="sale_order_location_rule" model="ir.rule">
            <field name="name">Sale Order - Location Filter</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[
                '|',
                ('location_id', '=', False),
                ('location_id', 'in', user.get_accessible_locations())
            ]</field>
        </record>

        <!-- Record Rules: Filter Purchase Orders by Location -->
        <record id="purchase_order_location_rule" model="ir.rule">
            <field name="name">Purchase Order - Location Filter</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">[
                '|',
                ('location_id', '=', False),
                ('location_id', 'in', user.get_accessible_locations())
            ]</field>
        </record>

        <!-- Record Rules: Filter Stock Moves by Location -->
        <record id="stock_move_location_rule" model="ir.rule">
            <field name="name">Stock Move - Location Filter</field>
            <field name="model_id" ref="stock.model_stock_move"/>
            <field name="domain_force">[
                '|',
                ('org_location_id', '=', False),
                ('org_location_id', 'in', user.get_accessible_locations())
            ]</field>
        </record>

        <!-- Record Rules: Filter Invoices/Bills by Location -->
        <record id="account_move_location_rule" model="ir.rule">
            <field name="name">Account Move - Location Filter</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[
                '|',
                ('location_id', '=', False),
                ('location_id', 'in', user.get_accessible_locations())
            ]</field>
        </record>

        <!-- Neutralize Standard Salesperson-based Rules -->
        <!-- We use function calls to force update records that are marked with noupdate="1" in base modules -->
        
        <function name="write" model="ir.rule">
            <value eval="[ref('sale.sale_order_personal_rule')]"/>
            <value eval="{'domain_force': '[(1, \'=\', 1)]'}"/>
        </function>

        <function name="write" model="ir.rule">
            <value eval="[ref('sale.sale_order_line_personal_rule')]"/>
            <value eval="{'domain_force': '[(1, \'=\', 1)]'}"/>
        </function>

        <function name="write" model="ir.rule">
            <value eval="[ref('sale.sale_order_report_personal_rule')]"/>
            <value eval="{'domain_force': '[(1, \'=\', 1)]'}"/>
        </function>

        <function name="write" model="ir.rule">
            <value eval="[ref('sale.account_invoice_rule_see_personal')]"/>
            <value eval="{'domain_force': '[(1, \'=\', 1)]'}"/>
        </function>

        <function name="write" model="ir.rule">
            <value eval="[ref('sale.account_invoice_line_rule_see_personal')]"/>
            <value eval="{'domain_force': '[(1, \'=\', 1)]'}"/>
        </function>

        <function name="write" model="ir.rule">
            <value eval="[ref('sale.account_invoice_report_rule_see_personal')]"/>
            <value eval="{'domain_force': '[(1, \'=\', 1)]'}"/>
        </function>

    </data>
</odoo>
