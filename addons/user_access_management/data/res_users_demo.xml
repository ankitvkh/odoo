<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Demo Users with Multi-Location Access -->
        
        <!-- User 1: Single Location User -->
        <record id="user_single_location" model="res.users">
            <field name="name">John Smith</field>
            <field name="login">john.smith@example.com</field>
            <field name="email">john.smith@example.com</field>
            <field name="location_id" ref="location_master_mumbai"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>
        
        <!-- User 2: Multi-Location User (Primary + 2 Secondary) -->
        <record id="user_multi_location_2" model="res.users">
            <field name="name">Sarah Johnson</field>
            <field name="login">sarah.johnson@example.com</field>
            <field name="email">sarah.johnson@example.com</field>
            <field name="location_id" ref="location_master_delhi"/>
            <field name="secondary_location_ids" eval="[(6, 0, [
                ref('location_master_mumbai'),
                ref('location_master_bangalore')
            ])]"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>
        
        <!-- User 3: Multi-Location User (Primary + 3 Secondary) -->
        <record id="user_multi_location_3" model="res.users">
            <field name="name">Michael Chen</field>
            <field name="login">michael.chen@example.com</field>
            <field name="email">michael.chen@example.com</field>
            <field name="location_id" ref="location_master_bangalore"/>
            <field name="secondary_location_ids" eval="[(6, 0, [
                ref('location_master_mumbai'),
                ref('location_master_delhi'),
                ref('location_master_pune')
            ])]"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>
        
        <!-- User 4: Regional Manager with Multiple Locations -->
        <record id="user_regional_manager" model="res.users">
            <field name="name">Emily Rodriguez</field>
            <field name="login">emily.rodriguez@example.com</field>
            <field name="email">emily.rodriguez@example.com</field>
            <field name="location_id" ref="location_master_mumbai"/>
            <field name="secondary_location_ids" eval="[(6, 0, [
                ref('location_master_delhi'),
                ref('location_master_bangalore'),
                ref('location_master_pune'),
                ref('location_master_chennai')
            ])]"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('sales_team.group_sale_manager')])]"/>
        </record>
        
        <!-- User 5: No Location User -->
        <record id="user_no_location" model="res.users">
            <field name="name">David Wilson</field>
            <field name="login">david.wilson@example.com</field>
            <field name="email">david.wilson@example.com</field>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>
        
    </data>
</odoo>
