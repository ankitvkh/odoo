<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_material_indent_tree" model="ir.ui.view">
    <field name="name">material.indent.tree</field>
    <field name="model">material.indent</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="bom_id"/>
        <field name="project_id"/>
        <field name="state"/>
      </tree>
    </field>
  </record>

  <record id="view_material_indent_form" model="ir.ui.view">
    <field name="name">material.indent.form</field>
    <field name="model">material.indent</field>
    <field name="arch" type="xml">
      <form string="Material Indent">
        <header>
          <field name="state"/>
          <button name="action_submit" type="object" string="Submit" attrs="{ 'invisible': [('state', '!=', 'draft')] }"/>
          <button name="action_approve" type="object" string="Approve" attrs="{ 'invisible': [('state', '!=', 'submitted')] }"/>
          <button name="action_cancel" type="object" string="Cancel" attrs="{ 'invisible': [('state', '=', 'cancel')] }"/>
        </header>
        <sheet>
          <group>
            <field name="name" readonly="1"/>
            <field name="bom_id"/>
            <field name="project_id"/>
            <button name="action_load_from_bom" type="object" string="Load from BOM"/>
          </group>
          <notebook>
            <page string="Lines">
              <field name="indent_line_ids">
                <tree editable="bottom">
                  <field name="product_id"/>
                  <field name="product_name"/>
                  <field name="product_qty"/>
                  <field name="uom_id"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_material_indent" model="ir.actions.act_window">
    <field name="name">Material Indents</field>
    <field name="res_model">material.indent</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_material_indent_root" name="Material Indent" sequence="90"/>
  <menuitem id="menu_material_indent_main" parent="menu_material_indent_root" name="Indents" action="action_material_indent"/>

</odoo>
