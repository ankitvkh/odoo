<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_material_indent_tree" model="ir.ui.view">
    <field name="name">material.indent.tree</field>
    <field name="model">material.indent</field>
    <field name="arch" type="xml">
      <list decoration-info="state == 'draft'" 
            decoration-warning="state == 'submitted'" 
            decoration-success="state == 'approved'"
            decoration-muted="state == 'cancel'">
        <field name="name"/>
        <field name="bom_id"/>
        <field name="bom_flow_type" optional="show"/>
        <field name="project_id" optional="show"/>
        <field name="purchase_count" optional="show"/>
        <field name="state" widget="badge" 
               decoration-info="state == 'draft'"
               decoration-warning="state == 'submitted'"
               decoration-success="state == 'approved'"/>
        <field name="company_id" groups="base.group_multi_company" optional="hide"/>
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_material_indent_form" model="ir.ui.view">
    <field name="name">material.indent.form</field>
    <field name="model">material.indent</field>
    <field name="arch" type="xml">
      <form string="Material Indent">
        <header>
          <button name="action_submit" 
                  type="object" 
                  string="Submit for Approval" 
                  class="oe_highlight"
                  invisible="state != 'draft'"/>
          <button name="action_approve" 
                  type="object" 
                  string="Approve" 
                  class="oe_highlight"
                  invisible="state != 'submitted'"
                  groups="purchase.group_purchase_manager"/>
          <button name="action_create_purchase_orders" 
                  type="object" 
                  string="Generate Purchase Orders" 
                  class="btn-primary"
                  invisible="state != 'approved' or purchase_count &gt; 0"
                  groups="purchase.group_purchase_user,purchase.group_purchase_manager"/>
          <button name="action_cancel" 
                  type="object" 
                  string="Cancel"
                  invisible="state in ['cancel', 'approved']"
                  confirm="Are you sure you want to cancel this indent?"/>
          <button name="action_reset_to_draft" 
                  type="object" 
                  string="Reset to Draft"
                  invisible="state != 'cancel'"
                  groups="purchase.group_purchase_manager"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
        </header>
        
        <sheet>
          <!-- Smart Buttons -->
          <div class="oe_button_box" name="button_box">
            <button name="action_view_purchase_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    invisible="purchase_count == 0">
              <field name="purchase_count" widget="statinfo" string="Purchase Orders"/>
            </button>
          </div>
          
          <!-- Title -->
          <div class="oe_title">
            <h1>
              <field name="name" readonly="1"/>
            </h1>
          </div>
          
          <!-- Main Information -->
          <group>
            <group>
              <field name="bom_id" 
                     options="{'no_create': True}"
                     readonly="state != 'draft'"/>
              <field name="bom_flow_type" readonly="1"/>
              <field name="project_id" 
                     readonly="state != 'draft'"
                     invisible="bom_flow_type != 'project'"/>
            </group>
            <group>
              <field name="company_id" groups="base.group_multi_company"/>
              <button name="action_load_from_bom" 
                      type="object" 
                      string="Load from BOM"
                      class="btn-primary"
                      invisible="state != 'draft'"
                      help="Load components from the selected BOM"/>
            </group>
          </group>
          
          <!-- Alert for Spare Parts Flow -->
          <div class="alert alert-info" role="alert" invisible="bom_flow_type != 'spare'">
            <strong>Spare Parts Flow:</strong> This indent uses exact product names from inventory. 
            BOM name matches product name throughout the process.
          </div>
          
          <!-- Alert for Project Flow -->
          <div class="alert alert-info" role="alert" invisible="bom_flow_type != 'project'">
            <strong>Project Flow:</strong> BOM has custom project name. 
            Indent lines automatically use inventory product names.
          </div>
          
          <!-- Indent Lines -->
          <notebook>
            <page string="Indent Lines" name="indent_lines">
              <field name="indent_line_ids" readonly="state != 'draft'">
                <list editable="bottom" decoration-danger="available_qty &lt; product_qty">
                  <field name="serial_no" string="Sr. No." readonly="1"/>
                  <field name="product_id" 
                         options="{'no_create': True}"
                         domain="[('type', 'in', ['product', 'consu'])]"/>
                  <field name="product_name" 
                         readonly="1"
                         string="Inventory Product Name"/>
                  <field name="make" optional="show"/>
                  <field name="description_short" string="Description" optional="show"/>
                  <field name="product_qty"/>
                  <field name="uom_id" groups="uom.group_uom"/>
                  <field name="available_qty" optional="show"/>
                  <field name="vendor_id" optional="show"/>
                </list>
              </field>
            </page>
            
            <page string="Purchase Orders" name="purchase_orders" invisible="purchase_count == 0">
              <field name="purchase_order_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="partner_id"/>
                  <field name="date_order"/>
                  <field name="amount_total"/>
                  <field name="state"/>
                </list>
              </field>
            </page>
          </notebook>
          
        </sheet>
        
        <!-- Chatter -->
        <div class="oe_chatter">
          <field name="message_follower_ids" groups="base.group_user"/>
          <field name="activity_ids"/>
          <field name="message_ids"/>
        </div>
        
      </form>
    </field>
  </record>

  <!-- Search View -->
  <record id="view_material_indent_search" model="ir.ui.view">
    <field name="name">material.indent.search</field>
    <field name="model">material.indent</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Indent Reference"/>
        <field name="bom_id"/>
        <field name="project_id"/>
        <separator/>
        <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
        <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
        <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
        <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancel')]"/>
        <separator/>
        <filter string="Project Flow" name="project_flow" domain="[('bom_flow_type', '=', 'project')]"/>
        <filter string="Spare Parts Flow" name="spare_flow" domain="[('bom_flow_type', '=', 'spare')]"/>
        <separator/>
        <filter string="With Project" name="with_project" domain="[('project_id', '!=', False)]"/>
        <group expand="0" string="Group By">
          <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
          <filter string="Flow Type" name="group_flow" context="{'group_by': 'bom_flow_type'}"/>
          <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
          <filter string="BOM" name="group_bom" context="{'group_by': 'bom_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_material_indent" model="ir.actions.act_window">
    <field name="name">Material Indents</field>
    <field name="res_model">material.indent</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_material_indent_search"/>
    <field name="context">{'search_default_draft': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first Material Indent
      </p>
      <p>
        Material indents are created from BOMs to requisition materials.<br/>
        Click the "Create" button or use "Create Material Indent" from a BOM.
      </p>
    </field>
  </record>

  <!-- No separate menu - integrated into BOM -->

</odoo>