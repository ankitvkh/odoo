<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Tree View Inheritance -->
    <record id="product_template_tree_view_inherit_material_indent" model="ir.ui.view">
        <field name="name">product.template.list.inherit.material.indent</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="make" optional="show"/>
                <field name="description_short" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Product Template Form View Inheritance -->
    <record id="product_template_form_view_inherit_material_indent" model="ir.ui.view">
        <field name="name">product.template.form.inherit.material.indent</field>
        <field name="model" >product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="make" placeholder="e.g. SKF, Siemens"/>
                <field name="description_short" placeholder="Brief identification description"/>
            </xpath>
        </field>
    </record>

    <!-- Product Template Search View Inheritance -->
    <record id="product_template_search_view_inherit_material_indent" model="ir.ui.view">
        <field name="name">product.template.search.inherit.material.indent</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="make"/>
            </xpath>
            <xpath expr="//filter[@name='filter_to_sell']" position="before">
                <filter string="With Make" name="with_make" domain="[('make', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Make" name="group_make" context="{'group_by': 'make'}"/>
                </group>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
