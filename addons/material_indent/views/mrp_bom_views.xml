<?xml version="1.0" encoding="utf-8"?>
<odoo>  
  <record id="view_mrp_bom_form_inherit_material_indent" model="ir.ui.view">
    <field name="name">mrp.bom.form.material.indent</field>
    <field name="model">mrp.bom</field>
    <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
    <field name="arch" type="xml">
      
      <!-- Add smart button -->
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_indents" 
                type="object" 
                class="oe_stat_button" 
                icon="fa-list">
          <field name="indent_count" widget="statinfo" string="Indents"/>
        </button>
      </xpath>
      
      <!-- Add flow type and project fields -->
      <xpath expr="//group[last()]" position="after">
        <group name="material_indent_info" string="Material Indent Configuration">
          <group>
            <field name="bom_flow_type" widget="radio" options="{'horizontal': true}"/>
            <field name="project_id" 
                   invisible="bom_flow_type != 'project'"
                   required="bom_flow_type == 'project'"/>
            <field name="project_reference" 
                   invisible="bom_flow_type != 'project'"
                   placeholder="e.g., PROJ-2025-001"/>
          </group>
          <group>
            <div class="alert alert-info" role="alert" invisible="bom_flow_type != 'project'">
              <strong>Project BOM:</strong> supports custom descriptions.
              <br/>
              <em>Example:</em> "Rebar" mapped to "Steel Rod 12mm".
            </div>
            <div class="alert alert-warning" role="alert" invisible="bom_flow_type != 'spare'">
              <strong>Spare Parts BOM:</strong> requires exact name matching.
              <br/>
              <em>Example:</em> "SKF Bearing 6308" must match inventory.
            </div>
          </group>
        </group>
        
        <!-- Material Indent Lines directly in BOM -->
        <group name="material_indent_lines" string="Material Indent Lines">
          <field name="material_indent_line_ids" nolabel="1">
            <list editable="bottom" decoration-info="flow_type == 'project'" decoration-warning="flow_type == 'spare'">
              <field name="indent_reference" string="Indent Ref"/>
              <field name="custom_description" string="BOM Description" optional="show"/>
              <field name="product_id" string="Inventory Product" domain="[('type', 'in', ['product', 'consu'])]"/>
              <field name="product_name" string="Inventory Name" readonly="1"/>
              <field name="make" optional="show"/>
              <field name="description_short" string="Description" optional="show"/>
              <field name="product_qty"/>
              <field name="uom_id"/>
              <field name="flow_type" invisible="1"/>
              <field name="state" widget="badge"/>
            </list>
          </field>
        </group>
      </xpath>
      
      <!-- Add Load from BOM button -->
      <xpath expr="//group[@name='material_indent_lines']" position="after">
        <group>
          <button name="action_load_bom_components" 
                  type="object" 
                  string="Load Components from BOM" 
                  class="btn-primary"
                  help="Auto-populate material indent lines from BOM components"/>
          <button name="action_generate_purchase_orders" 
                  type="object" 
                  string="Generate Purchase Orders" 
                  class="btn-success"
                  help="Create purchase orders from approved indent lines"/>
        </group>
      </xpath>
      
      <!-- Enhance BOM lines to show custom descriptions -->
      <xpath expr="//field[@name='bom_line_ids']//list" position="attributes">
        <attribute name="decoration-info">parent.bom_flow_type == 'project'</attribute>
        <attribute name="decoration-warning">parent.bom_flow_type == 'spare'</attribute>
      </xpath>
      
      <!-- Add custom fields to BOM lines -->
      <xpath expr="//field[@name='bom_line_ids']//list//field[@name='product_id']" position="after">
        <field name="custom_product_description" 
               string="Custom Description"
               optional="show"
               column_invisible="parent.bom_flow_type == 'spare'"
               help="Project BOM: Custom name (mapped to inventory)."/>
        <field name="inventory_product_id" 
               string="Inventory Product"
               optional="show"
               column_invisible="parent.bom_flow_type == 'spare'"
               help="Actual inventory product this maps to"/>
        <field name="make" optional="show"/>
        <field name="description_short" string="Description" optional="show"/>
      </xpath>
      
    </field>
  </record>
</odoo>