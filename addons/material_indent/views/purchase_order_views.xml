<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order Form View Inheritance -->
    <record id="purchase_order_form_inherit_material_indent" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.material.indent</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="after">
                <field name="make" optional="show"/>
                <field name="description_short" string="Description" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Tree View Inheritance -->
    <record id="purchase_order_kpis_tree_inherit_material_indent" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.material.indent</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='partner_id']" position="after">
                <!-- Note: This is on the PO list level, usually we don't show line details here, 
                     but if they wanted it, we could. For now we stick to lines. -->
            </xpath>
        </field>
    </record>
</odoo>
