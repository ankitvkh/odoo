<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Enhanced Sale Order Form View -->
    <record id="view_order_form_enhanced" model="ir.ui.view">
        <field name="name">sale.order.form.enhanced</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Add control buttons for Order Lines -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="context">{
                    'default_order_id': id,
                    'default_offer_type': offer_type,
                }</attribute>
            </xpath>

            <!-- Add Serial Number column as first column in order_line -->
            <xpath expr="//field[@name='order_line']/list//field[@name='sequence']" position="after">
                <field name="serial_no" string="Sr. No." readonly="1"/>
            </xpath>

            <!-- Add brand/make, short description, and alias to order lines list view -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_template_id']" position="after">
                <field name="make" optional="show" readonly="1"/>
                <field name="description_short" optional="show" readonly="1"/>
                <field name="alias" optional="show"/>
            </xpath>

            <!-- Conditional display of prices and subtotals based on offer_type in inline tree view -->
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="replace">
                <field name="price_unit" string="Unit Price" column_invisible="parent.offer_type == 'technical'"/>
                <field name="price_unit_display" string="Unit Price" column_invisible="parent.offer_type != 'technical'"/>
            </xpath>
            
            <xpath expr="//field[@name='order_line']/list//field[@name='price_subtotal']" position="replace">
                <field name="price_subtotal" string="Subtotal" column_invisible="parent.offer_type == 'technical'"/>
                <field name="price_subtotal_display" string="Subtotal" column_invisible="parent.offer_type != 'technical'"/>
            </xpath>
            
            <xpath expr="//field[@name='order_line']/list//field[@name='price_total']" position="replace">
                <field name="price_total" string="Total" column_invisible="parent.offer_type == 'technical'"/>
                <field name="price_total_display" string="Total" column_invisible="parent.offer_type != 'technical'"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='price_tax']" position="replace">
                <field name="price_tax" string="Taxes" column_invisible="parent.offer_type == 'technical'"/>
                <field name="price_tax_display" string="Taxes" column_invisible="parent.offer_type != 'technical'"/>
            </xpath>

            <!-- Add invisible totals fields so Odoo client tracks them for recomputations -->
            <xpath expr="//field[@name='order_line']" position="before">
                <field name="amount_untaxed" invisible="1"/>
                <field name="amount_tax" invisible="1"/>
                <field name="amount_total" invisible="1"/>
            </xpath>

            <!-- Replace standard totals with conditional display based on offer_type -->
            <xpath expr="//group[@name='sale_total']" position="replace">
                <!-- Standard Odoo tax totals (shown when not technical offer) -->
                <group class="oe_subtotal_footer d-flex order-0 order-lg-1 flex-column gap-0 gap-sm-3" 
                       colspan="2" 
                       name="sale_total" 
                       invisible="offer_type == 'technical'">
                    <field name="tax_totals" widget="account-tax-totals-field" nolabel="1" readonly="1"/>
                </group>
                
                <!-- Custom "Quoted" display totals (shown only for technical offers) -->
                <group class="oe_subtotal_footer oe_right" 
                       colspan="2" 
                       name="sale_total_technical" 
                       invisible="offer_type != 'technical'">
                    <field name="amount_untaxed_display" readonly="1"/>
                    <field name="amount_tax_display" readonly="1"/>
                    <field name="amount_total_display" class="oe_subtotal_footer_separator" readonly="1"/>
                </group>
            </xpath>
            
            <!-- Add control buttons and custom tree view for Optional Products -->
            <xpath expr="//field[@name='sale_order_option_ids']" position="attributes">
                <attribute name="context">{
                    'default_order_id': id,
                    'default_offer_type': offer_type,
                    'tree_view_ref': 'sale_order_enhancement.view_sale_order_option_tree_enhanced',
                }</attribute>
            </xpath>
            
            <!-- Add totals summary below Optional Products -->
            <xpath expr="//page[@name='optional_products']" position="inside">
                <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total_option">
                    <field name="amount_untaxed_display"/>
                    <field name="amount_tax_display"/>
                    <field name="amount_total_display" class="oe_subtotal_footer_separator"/>
                </group>
            </xpath>
            
            <!-- Add custom reference code field in partner details -->
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="before">
                <field name="custom_ref_code" 
                       placeholder="Reference Code (XXXXX)"
                       readonly="state not in ['draft', 'sent']"/>
                <field name="offer_type" widget="selection" readonly="state not in ['draft', 'sent']"/>
                <field name="portal_ref_no" 
                       invisible="offer_type != 'technical'" 
                       readonly="offer_type != 'technical' or state not in ['draft', 'sent']"
                       required="offer_type == 'technical'"/>
            </xpath>
            
        </field>
    </record>
    
    <!-- Enhanced Order Line Tree View with Section/Note/Catalog options -->
    <record id="view_order_line_tree_enhanced" model="ir.ui.view">
        <field name="name">sale.order.line.tree.enhanced</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Order Lines" editable="bottom">
                <control>
                    <create string="Add a product"/>
                    <create string="Add a section" context="{'default_display_type': 'line_section'}"/>
                    <create string="Add a note" context="{'default_display_type': 'line_note'}"/>
                </control>
                
                <field name="display_type" column_invisible="True"/>
                <field name="sequence" widget="handle"/>
                
                <!-- Section/Note display -->
                <field name="name" widget="section_and_note_text" optional="show"/>
                
                <!-- Product fields -->
                <field name="product_template_id"
                       string="Product"
                       readonly="state in ('sale', 'done', 'cancel')"
                       required="not display_type and not is_downpayment"
                       context="{
                           'partner_id': parent.partner_id,
                           'quantity': product_uom_qty,
                           'pricelist': parent.pricelist_id,
                           'uom':product_uom,
                           'company_id': parent.company_id,
                           'default_list_price': price_unit,
                       }"
                       options="{
                           'no_open': True,
                       }"
                       optional="show"
                       domain="[('sale_ok', '=', True)]"
                       widget="sol_product_many2one"
                       placeholder="Type to find a product..."/>
                
                <field name="product_id" column_invisible="True"/>
                <field name="make" optional="show" invisible="display_type in ('line_section', 'line_note')"/>
                <field name="description_short" optional="show" invisible="display_type in ('line_section', 'line_note')"/>
                <field name="alias" optional="show" invisible="display_type in ('line_section', 'line_note')"/>
                
                <field name="product_uom_category_id" column_invisible="True"/>
                <field name="is_downpayment" column_invisible="True"/>
                
                <!-- Invisible offer_type for compute dependency -->
                <field name="offer_type" column_invisible="True"/>
                
                <field name="product_uom_qty" 
                       optional="show"
                       invisible="display_type in ('line_section', 'line_note')"
                       readonly="state in ('sale', 'done', 'cancel')"
                       context="{'partner_id': parent.partner_id, 'quantity': product_uom_qty, 'pricelist': parent.pricelist_id, 'uom': product_uom, 'company_id': parent.company_id}"/>
                
                <field name="product_uom"
                       force_save="1"
                       string="UoM"
                       readonly="state in ('sale', 'done', 'cancel')"
                       required="not display_type and not is_downpayment"
                       context="{'company_id': parent.company_id}"
                       groups="uom.group_uom"
                       options='{"no_open": True}'
                       optional="show"/>
                
                <field name="price_unit_display" string="Unit Price"/>
                
                <field name="tax_id" 
                       widget="many2many_tags" 
                       optional="show"
                       invisible="display_type in ('line_section', 'line_note')"
                       readonly="state in ('sale', 'done', 'cancel')"
                       context="{'active_test': True}"
                       domain="[('type_tax_use', '=', 'sale'), ('company_id', '=', parent.company_id)]"/>
                
                <field name="discount" 
                       optional="show"
                       invisible="display_type in ('line_section', 'line_note')"
                       readonly="state in ('sale', 'done', 'cancel')"/>
                
                <field name="price_subtotal_display" string="Subtotal"/>
                
                <field name="price_tax_display" string="Taxes"/>
                
                <field name="price_total_display" string="Total"/>
                
                <field name="state" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>
    
    <!-- Enhanced Optional Products Tree View -->
    <record id="view_sale_order_option_tree_enhanced" model="ir.ui.view">
        <field name="name">sale.order.option.tree.enhanced</field>
        <field name="model">sale.order.option</field>
        <field name="arch" type="xml">
            <list string="Optional Products" editable="bottom">
                <control>
                    <create string="Add a product"/>
                    <create string="Add a section" context="{'default_display_type': 'line_section'}"/>
                    <create string="Add a note" context="{'default_display_type': 'line_note'}"/>
                </control>
                
                <field name="display_type" column_invisible="True"/>
                <field name="sequence" widget="handle"/>
                <field name="serial_no" string="Sr. No." readonly="1"/>
                
                <!-- Section/Note display -->
                <field name="name" widget="section_and_note_text" optional="show"/>
                
                <!-- Product fields -->
                <field name="product_id" 
                       optional="show"
                       invisible="display_type in ('line_section', 'line_note')"
                       required="not display_type"
                       readonly="0"
                       domain="[('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
                    
                <field name="make" optional="show" invisible="display_type in ('line_section', 'line_note')"/>
                <field name="description_short" optional="show" invisible="display_type in ('line_section', 'line_note')"/>
                
                <field name="quantity" 
                       optional="show"
                       context="{'partner_id': parent.partner_id, 'quantity': quantity, 'pricelist': parent.pricelist_id, 'uom': uom_id, 'company_id': parent.company_id}"
                       readonly="0"
                       invisible="display_type in ('line_section', 'line_note')"/>
                
                <field name="uom_id" 
                       optional="show"
                       invisible="display_type in ('line_section', 'line_note')"
                       readonly="0"
                       groups="uom.group_uom"/>
                
                <!-- Invisible offer_type for compute dependency -->
                <field name="offer_type" column_invisible="True"/>
                
                <field name="price_unit" string="Unit Price" column_invisible="parent.offer_type == 'technical'"/>
                <field name="price_unit_display" string="Unit Price" column_invisible="parent.offer_type != 'technical'"/>
                
                <field name="tax_id" 
                       widget="many2many_tags" 
                       optional="show"
                       invisible="display_type in ('line_section', 'line_note')"
                       readonly="0"
                       context="{'active_test': True}"
                       domain="[('type_tax_use', '=', 'sale'), ('company_id', '=', parent.company_id)]"/>
                
                <field name="discount" 
                       optional="show"
                       invisible="display_type in ('line_section', 'line_note')"
                       readonly="0"/>
                
                <field name="price_subtotal" string="Subtotal" column_invisible="parent.offer_type == 'technical'"/>
                <field name="price_subtotal_display" string="Subtotal" column_invisible="parent.offer_type != 'technical'"/>
                
                <field name="price_tax" string="Taxes" column_invisible="parent.offer_type == 'technical'"/>
                <field name="price_tax_display" string="Taxes" column_invisible="parent.offer_type != 'technical'"/>
                
                <field name="price_total" string="Total" column_invisible="parent.offer_type == 'technical'"/>
                <field name="price_total_display" string="Total" column_invisible="parent.offer_type != 'technical'"/>
            </list>
        </field>
    </record>
    
</odoo>
