<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit portal template to hide price in sidebar for Technical Offer -->
    <template id="sale_order_portal_template_enhanced" inherit_id="sale.sale_order_portal_template">
        <!-- Replace sidebar total amount -->
        <xpath expr="//t[@t-set='title']/h2[@data-id='total_amount']" position="replace">
            <h2 t-if="sale_order.offer_type == 'technical'" class="mb-0 text-break">Quoted Price</h2>
            <h2 t-else="" t-field="sale_order.amount_total" data-id="total_amount" class="mb-0 text-break"/>
        </xpath>
        
        <!-- Replace advantage section amounts -->
        <xpath expr="//div[@name='sale_order_advantage']//b[@data-id='amount_undiscounted']" position="replace">
            <b t-if="sale_order.offer_type == 'technical'">Quoted Price</b>
            <b t-else="" t-field="sale_order.amount_undiscounted"
                t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                style="text-decoration: line-through"
                class="d-block mt-1"
                data-id="amount_undiscounted" />
        </xpath>
        
        <xpath expr="//div[@name='sale_order_advantage']//h4[@data-id='total_amount']" position="replace">
            <h4 t-if="sale_order.offer_type == 'technical'" class="text-success" data-id="total_amount">Quoted Price</h4>
            <h4 t-else="" t-field="sale_order.amount_total" class="text-success" data-id="total_amount"/>
        </xpath>
        
        <xpath expr="//div[@name='sale_order_advantage']//h4[@data-id='total_untaxed']" position="replace">
            <h4 t-if="sale_order.offer_type == 'technical'" class="text-success mb-0" data-id="total_untaxed">Quoted Price</h4>
            <h4 t-else="" t-field="sale_order.amount_untaxed" class="text-success mb-0" data-id="total_untaxed"/>
        </xpath>
        
        <xpath expr="//div[@name='sale_order_advantage']//span[@data-id='total_amount']" position="replace">
            <span t-if="sale_order.offer_type == 'technical'" data-id="total_amount">Quoted Price</span>
            <span t-else="" t-field="sale_order.amount_total" data-id="total_amount"/>
        </xpath>
        
        <!-- Replace modal amounts -->
        <xpath expr="//main[@id='sign-dialog']//b[@data-id='total_amount']" position="replace">
            <b t-if="sale_order.offer_type == 'technical'" data-id="total_amount">Quoted Price</b>
            <b t-else="" data-id="total_amount" t-field="sale_order.amount_total"/>
        </xpath>
    </template>

    <!-- Inherit portal content to hide prices in product table for Technical Offer -->
    <template id="sale_order_portal_content_enhanced" inherit_id="sale.sale_order_portal_content">
        <!-- Replace Unit Price column values -->
        <xpath expr="//td[@id='subtotal']/span[@class='oe_order_line_price_subtotal']" position="before">
            <t t-if="sale_order.offer_type == 'technical'">
                <!-- Override unit price display for technical offers -->
                <t t-set="_is_technical_offer" t-value="True"/>
            </t>
        </xpath>
        
        <!-- Replace Unit Price display -->
        <xpath expr="//div[@t-field='line.price_unit']" position="replace">
            <div t-if="sale_order.offer_type == 'technical'">Quoted Price</div>
            <div t-else=""
                t-if="line.discount &gt;= 0"
                t-field="line.price_unit"
                t-att-style="line.discount and 'text-decoration: line-through' or None"
                t-att-class="(line.discount and 'text-danger' or '') + ' text-end'"
            />
        </xpath>
        
        <!-- Replace discounted price display -->
        <xpath expr="//div[@t-if='line.discount']" position="attributes">
            <attribute name="t-if">line.discount and sale_order.offer_type != 'technical'</attribute>
        </xpath>
        
        <!-- Replace Taxes column values -->
        <xpath expr="//td[@id='taxes']/span" position="replace">
            <span t-if="sale_order.offer_type == 'technical'">Quoted Price</span>
            <span t-else="" t-out="', '.join(map(lambda x: (x.name), line.tax_id))"/>
        </xpath>
        
        <!-- Replace Amount column values -->
        <xpath expr="//td[@id='subtotal']/span[@class='oe_order_line_price_subtotal']" position="replace">
            <span t-if="sale_order.offer_type == 'technical'" class="oe_order_line_price_subtotal">Quoted Price</span>
            <span t-else="" class="oe_order_line_price_subtotal" t-field="line.price_subtotal"/>
        </xpath>
        
        <!-- Replace section subtotal -->
        <xpath expr="//span[@t-out='current_subtotal']" position="replace">
            <span t-if="sale_order.offer_type == 'technical'">Quoted Price</span>
            <span t-else="" t-out="current_subtotal"
                t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
            />
        </xpath>
        
        <!-- Replace totals table -->
        <xpath expr="//div[@id='total']//t[@t-call='sale.sale_order_portal_content_totals_table']" position="replace">
            <t t-if="sale_order.offer_type == 'technical'">
                <table class="table table-sm" name="sale_order_totals_table">
                    <tr class="border-black o_total">
                        <td><strong>Total</strong></td>
                        <td class="text-end">
                            <span class="text-nowrap">Quoted Price</span>
                        </td>
                    </tr>
                </table>
            </t>
            <t t-else="">
                <t t-call="sale.sale_order_portal_content_totals_table"/>
            </t>
        </xpath>
    </template>
</odoo>
