<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Set external_report_layout_id for companies to avoid missing headers/footers -->
        <function model="res.company" name="write">
            <value model="res.company" eval="obj().search([('external_report_layout_id', '=', False)]).ids"/>
            <value eval="{'external_report_layout_id': ref('web.external_layout_standard')}"/>
        </function>
    </data>
</odoo>
