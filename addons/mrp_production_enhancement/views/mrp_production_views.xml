<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_enhanced" model="ir.ui.view">
        <field name="name">mrp.production.form.view.enhanced</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_id']" position="before">
                <field name="serial_no" string="Sr. No." readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
