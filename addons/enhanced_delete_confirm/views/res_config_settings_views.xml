<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_enhanced_delete" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.enhanced.delete</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Enhanced Delete" name="enhanced_delete_confirm">
                    <block title="Enhanced Delete Confirmation">
                        <setting help="Enable enhanced delete confirmation with unlink/cascade options">
                            <field name="enhanced_delete_enabled"/>
                            <label for="enhanced_delete_enabled"/>
                        </setting>
                        
                        <setting string="Minimum Records" help="Show confirmation only when deleting this many records or more">
                            <field name="enhanced_delete_min_records"/>
                        </setting>
                        
                        <setting string="Excluded Models" help="Comma-separated list of models to exclude (e.g., ir.ui.menu,ir.model)">
                            <field name="enhanced_delete_excluded_models" placeholder="ir.ui.menu,ir.model,ir.model.fields"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>