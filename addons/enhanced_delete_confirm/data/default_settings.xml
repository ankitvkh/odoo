<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default configuration parameters -->
        <record id="default_enhanced_delete_enabled" model="ir.config_parameter">
            <field name="key">enhanced_delete_confirm.enabled</field>
            <field name="value">True</field>
        </record>

        <record id="default_enhanced_delete_min_records" model="ir.config_parameter">
            <field name="key">enhanced_delete_confirm.min_records</field>
            <field name="value">1</field>
        </record>

        <record id="default_enhanced_delete_excluded_models" model="ir.config_parameter">
            <field name="key">enhanced_delete_confirm.excluded_models</field>
            <field name="value">ir.ui.menu,ir.model,ir.model.fields,ir.module.module</field>
        </record>
    </data>
</odoo>